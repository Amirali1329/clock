<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ساعت، آلارم، تایمر و کرنومتر</title>
<style>
:root{--primary:#4285F4;--secondary:#34A853;--danger:#EA4335;--purple:#9C27B0;--bg-dark:#121212;--bg-light:#1E1E1E;--text:#FFF;--text2:#B0B0B0;}
*{box-sizing:border-box;}
body{background:var(--bg-dark);margin:0;padding:0;font-family:Tahoma,sans-serif;color:var(--text);min-height:100vh;display:flex;flex-direction:column;}
.header{padding:16px;text-align:center;background:var(--bg-light);}
.header h1{font-size:20px;margin:0;}
.clock-container{flex:1;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:20px 0;}
.time{font-size:120px;font-weight:300;letter-spacing:-4px;margin-bottom:-10px;line-height:1;}
.seconds{font-size:36px;opacity:.7;}
.date{font-size:18px;opacity:.7;margin-top:10px;}
.tabs{display:flex;justify-content:center;margin-bottom:20px;flex-wrap:wrap;padding:0 10px;}
.tab{padding:10px 20px;cursor:pointer;background:#2D2D2D;border:none;color:var(--text);font-size:16px;flex-grow:1;max-width:150px;font-family:inherit;}
.tab.active{background:var(--primary);}
.tab:first-child{border-radius:8px 0 0 8px;}
.tab:last-child{border-radius:0 8px 8px 0;}
.content-container{background:var(--bg-light);padding:20px;border-radius:16px;margin:0 auto 20px;width:80%;max-width:500px;}
.tab-content{display:none;}
.tab-content.active{display:block;}
.form-group{display:flex;flex-direction:column;margin-bottom:15px;}
label{margin-bottom:8px;font-size:14px;color:var(--text2);}
input,select{padding:12px;border-radius:8px;border:1px solid #333;background:#2D2D2D;color:white;font-size:16px;font-family:inherit;width:100%;}
button{color:white;border:none;padding:12px;border-radius:8px;font-size:16px;cursor:pointer;margin-top:10px;font-family:inherit;}
button:disabled{opacity:.4;cursor:not-allowed;}
.display{font-size:48px;text-align:center;margin:20px 0;font-family:monospace;direction:ltr;}
.controls{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;}
.control-btn{padding:10px 20px;border-radius:8px;font-size:16px;min-width:80px;}
.primary-btn{background:var(--primary);}
.secondary-btn{background:var(--secondary);}
.danger-btn{background:var(--danger);}
.purple-btn{background:var(--purple);}
.items-list{margin-top:20px;}
.item{display:flex;justify-content:space-between;align-items:center;padding:12px;background:#2D2D2D;border-radius:8px;margin-bottom:10px;gap:10px;}
.delete-btn{background:var(--danger);color:white;border:none;padding:6px 12px;border-radius:4px;cursor:pointer;margin:0;font-size:14px;}
.lap-list{margin-top:20px;max-height:200px;overflow-y:auto;}
.lap-item{padding:8px;border-bottom:1px solid #333;display:flex;justify-content:space-between;font-family:monospace;direction:ltr;}
.world-clock-container{display:flex;flex-direction:column;align-items:center;}
.globe-container{position:relative;width:250px;height:250px;margin:20px auto;}
.globe{width:100%;height:100%;background:url('https://upload.wikimedia.org/wikipedia/commons/thumb/8/80/Earth_-_Blender_OpenGL.png/1200px-Earth_-_Blender_OpenGL.png') no-repeat center center;background-size:cover;border-radius:50%;box-shadow:0 0 20px rgba(66,133,244,.5);animation:rotate 60s linear infinite;}
@keyframes rotate{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}
.city-marker{position:absolute;width:8px;height:8px;border-radius:50%;transform:translate(-50%,-50%);cursor:pointer;z-index:2;}
.selected-city{font-size:24px;margin:10px 0;color:var(--primary);}
.city-time{font-size:36px;margin:10px 0;font-family:monospace;direction:ltr;}
.city-date{font-size:16px;opacity:.8;}
.city-selector{width:100%;margin:15px 0;}
.cities-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px;margin-top:20px;width:100%;}
.city-card{background:#2D2D2D;padding:10px;border-radius:8px;text-align:center;cursor:pointer;}
.city-card.active{background:var(--primary);}
.city-name{font-weight:500;margin-bottom:5px;font-size:14px;}
.city-time-small{font-size:14px;font-family:monospace;direction:ltr;}
.sleep-mode-form,.auto-sleep-mode{background:#2D2D2D;padding:15px;border-radius:8px;margin-bottom:20px;}
.sleep-history .item{display:flex;justify-content:space-between;padding:10px;background:#2D2D2D;border-radius:8px;margin-bottom:8px;}
.sleep-history .sleep-time{color:var(--purple);}
.sleep-history .wakeup-time{color:var(--secondary);}
.sleep-history .date{font-size:12px;opacity:.7;}
small{font-size:12px;color:var(--text2);margin-top:4px;}
body.sleep-mode{filter:grayscale(100%) brightness(.7);}
.alarm-overlay{position:fixed;inset:0;background:rgba(0,0,0,.85);display:none;flex-direction:column;justify-content:center;align-items:center;z-index:1000;padding:20px;text-align:center;}
.alarm-overlay.active{display:flex;}
.alarm-overlay h2{font-size:32px;margin-bottom:10px;color:var(--danger);}
.alarm-overlay p{font-size:20px;margin-bottom:30px;}
.alarm-overlay button{background:var(--danger);padding:14px 40px;font-size:18px;}
@media (max-width:600px){.time{font-size:80px;}.seconds{font-size:24px;}.content-container{width:90%;padding:15px;}.display{font-size:32px;}.tab{padding:8px 10px;font-size:13px;max-width:none;}.globe-container{width:200px;height:200px;}}
</style>
</head>
<body>
<div class="header"><h1>ساعت، آلارم، تایمر و کرنومتر</h1></div>
<div class="clock-container">
<div class="time" id="hours-minutes">--:--</div>
<span class="seconds" id="seconds">--</span>
<div class="date" id="date">--- -- ----</div>
</div>
<div class="tabs" role="tablist">
<button class="tab active" data-tab="alarm-tab" role="tab" aria-selected="true">آلارم</button>
<button class="tab" data-tab="timer-tab" role="tab" aria-selected="false">تایمر</button>
<button class="tab" data-tab="stopwatch-tab" role="tab" aria-selected="false">کرنومتر</button>
<button class="tab" data-tab="world-clock-tab" role="tab" aria-selected="false">ساعت جهانی</button>
<button class="tab" data-tab="sleep-time-tab" role="tab" aria-selected="false">تایم خواب</button>
</div>
<div class="content-container">
<div id="alarm-tab" class="tab-content active" role="tabpanel">
<h2>تنظیم آلارم</h2>
<div class="form-group"><label for="alarm-time">زمان آلارم:</label><input type="time" id="alarm-time"></div>
<div class="form-group"><label for="alarm-name">عنوان (اختیاری):</label><input type="text" id="alarm-name" placeholder="مثلاً بیدار شدن"></div>
<button class="primary-btn" id="set-alarm">تنظیم آلارم</button>
<div class="items-list" id="alarms-list"><h3>آلارم‌های فعال</h3></div>
</div>
<div id="timer-tab" class="tab-content" role="tabpanel">
<h2>تایمر</h2>
<div class="form-group"><label for="timer-hours">ساعت:</label><input type="number" id="timer-hours" min="0" max="23" value="0"></div>
<div class="form-group"><label for="timer-minutes">دقیقه:</label><input type="number" id="timer-minutes" min="0" max="59" value="0"></div>
<div class="form-group"><label for="timer-seconds">ثانیه:</label><input type="number" id="timer-seconds" min="0" max="59" value="0"></div>
<div class="display" id="timer-display">00:00:00</div>
<div class="controls">
<button class="control-btn secondary-btn" id="start-timer">شروع</button>
<button class="control-btn danger-btn" id="stop-timer" disabled>توقف</button>
<button class="control-btn purple-btn" id="reset-timer">تنظیم مجدد</button>
</div>
</div>
<div id="stopwatch-tab" class="tab-content" role="tabpanel">
<h2>کرنومتر</h2>
<div class="display" id="stopwatch-display">00:00:00.00</div>
<div class="controls">
<button class="control-btn secondary-btn" id="start-stopwatch">شروع</button>
<button class="control-btn danger-btn" id="stop-stopwatch" disabled>توقف</button>
<button class="control-btn primary-btn" id="lap-stopwatch" disabled>دور</button>
<button class="control-btn purple-btn" id="reset-stopwatch">تنظیم مجدد</button>
</div>
<div class="lap-list" id="lap-list"><h3>دورها</h3></div>
</div>
<div id="world-clock-tab" class="tab-content" role="tabpanel">
<h2>ساعت جهانی</h2>
<div class="world-clock-container">
<div class="globe-container"><div class="globe" id="globe"></div></div>
<div class="selected-city" id="selected-city-name">تهران</div>
<div class="city-time" id="selected-city-time">--:--:--</div>
<div class="city-date" id="selected-city-date">--- -- ----</div>
<select class="city-selector" id="city-selector" aria-label="انتخاب شهر"></select>
<div class="cities-grid" id="cities-grid"></div>
</div>
</div>
<div id="sleep-time-tab" class="tab-content" role="tabpanel">
<h2>تنظیم تایم خواب</h2>
<div class="sleep-mode-form">
<h3>تنظیمات دستی</h3>
<div class="form-group"><label for="bedtime">ساعت خواب:</label><input type="time" id="bedtime"></div>
<div class="form-group"><label for="wakeup-time">ساعت بیداری:</label><input type="time" id="wakeup-time"></div>
<button class="primary-btn" id="set-sleep-schedule">تنظیم برنامه خواب</button>
</div>
<div class="auto-sleep-mode">
<h3>تنظیمات خودکار</h3>
<div class="form-group"><label><input type="checkbox" id="auto-sleep-detection" style="width:auto;"> تشخیص خودکار</label><small>اگر ۱ ساعت از دستگاه استفاده نکنید، حالت خواب فعال می‌شود</small></div>
<div class="form-group"><label for="default-sleep-duration">مدت خواب پیش‌فرض (ساعت):</label><input type="number" id="default-sleep-duration" min="1" max="12" value="8.5" step="0.5"></div>
</div>
<div class="sleep-history"><h3>تاریخچه خواب</h3><div class="items-list" id="sleep-history-list"></div></div>
</div>
</div>

<div class="alarm-overlay" id="alarm-overlay">
<h2 id="alarm-overlay-title">آلارم</h2>
<p id="alarm-overlay-time"></p>
<button id="alarm-dismiss">خاموش کردن</button>
</div>

<audio id="alarm-sound" src="https://assets.mixkit.co/sfx/preview/mixkit-alarm-digital-clock-beep-989.mp3" preload="auto"></audio>
<audio id="timer-sound" src="https://assets.mixkit.co/sfx/preview/mixkit-sound-alert-digital-clock-1035.mp3" preload="auto"></audio>
<script>
(function(){
"use strict";

/* ---------- وضعیت ---------- */
var alarms=[];
var alarmSound=document.getElementById('alarm-sound');
var timerSound=document.getElementById('timer-sound');
var lastTickTime=Date.now();
var activeAlarm=null;

/* تایمر: مبتنی بر timestamp */
var timerState={running:false,endTime:0,remaining:0,intervalId:null};
/* استاپ‌واچ */
var swState={running:false,startTime:0,elapsed:0,intervalId:null,laps:[],lastLapElapsed:0};

var worldCities=[
{id:'Asia/Tehran',name:'تهران',lat:35.68,lng:51.38,color:'#EA4335'},
{id:'America/New_York',name:'نیویورک',lat:40.71,lng:-74.01,color:'#4285F4'},
{id:'Europe/London',name:'لندن',lat:51.51,lng:-0.13,color:'#34A853'},
{id:'Asia/Tokyo',name:'توکیو',lat:35.68,lng:139.77,color:'#FBBC05'},
{id:'Australia/Sydney',name:'سیدنی',lat:-33.87,lng:151.21,color:'#9C27B0'},
{id:'Europe/Paris',name:'پاریس',lat:48.86,lng:2.35,color:'#FF9800'},
{id:'Asia/Dubai',name:'دبی',lat:25.27,lng:55.31,color:'#00BCD4'},
{id:'Asia/Shanghai',name:'شانگهای',lat:31.23,lng:121.47,color:'#8BC34A'}
];
var selectedCity=worldCities[0];

var sleepSchedule={
  manualBedtime:null,        // "HH:MM"
  manualWakeupTime:null,     // "HH:MM"
  autoDetectionEnabled:false,
  defaultSleepDuration:8.5,
  lastInteractionTime:null,
  sleepModeActive:false
};
var sleepHistory=[];
var SLEEP_HISTORY_LIMIT=30;

/* ---------- کمکی ---------- */
function pad2(n){return (n<10?'0':'')+n;}
function formatHM(d){return pad2(d.getHours())+':'+pad2(d.getMinutes());}
function hmToMinutes(s){if(!s)return null;var p=s.split(':');return parseInt(p[0],10)*60+parseInt(p[1],10);}

/* ---------- ذخیره/بارگذاری ---------- */
function saveSleepData(){
  try{
    localStorage.setItem('sleepSchedule',JSON.stringify(sleepSchedule));
    localStorage.setItem('sleepHistory',JSON.stringify(sleepHistory));
  }catch(e){}
}
function loadSleepData(){
  try{
    var s=localStorage.getItem('sleepSchedule');
    var h=localStorage.getItem('sleepHistory');
    if(s){
      var p=JSON.parse(s);
      for(var k in p) if(p.hasOwnProperty(k)) sleepSchedule[k]=p[k];
      if(sleepSchedule.lastInteractionTime) sleepSchedule.lastInteractionTime=new Date(sleepSchedule.lastInteractionTime);
    }
    if(h){
      sleepHistory=JSON.parse(h).map(function(item){
        return {
          bedtime:item.bedtime?new Date(item.bedtime):null,
          wakeupTime:item.wakeupTime?new Date(item.wakeupTime):null,
          autoDetected:!!item.autoDetected
        };
      });
    }
  }catch(e){}
}
function saveAlarmsToLocalStorage(){
  try{
    // triggered را ذخیره نمی‌کنیم تا بعد از رفرش قفل نشود
    var clean=alarms.map(function(a){return {time:a.time,name:a.name};});
    localStorage.setItem('alarms',JSON.stringify(clean));
  }catch(e){}
}
function loadAlarmsFromLocalStorage(){
  try{
    var s=localStorage.getItem('alarms');
    if(s){
      var raw=JSON.parse(s);
      alarms=raw.map(function(a){
        return {time:a.time,name:a.name||'',triggered:false,lastTriggeredAt:0};
      });
    }
  }catch(e){}
}

/* ---------- حالت خواب ---------- */
function activateSleepMode(){
  if(sleepSchedule.sleepModeActive)return;
  document.body.classList.add('sleep-mode');
  sleepSchedule.sleepModeActive=true;
  sleepHistory.push({bedtime:new Date(),wakeupTime:null,autoDetected:true});
  if(sleepHistory.length>SLEEP_HISTORY_LIMIT) sleepHistory=sleepHistory.slice(-SLEEP_HISTORY_LIMIT);
  saveSleepData();renderSleepHistory();
}
function deactivateSleepMode(){
  if(!sleepSchedule.sleepModeActive)return;
  document.body.classList.remove('sleep-mode');
  sleepSchedule.sleepModeActive=false;
  if(sleepHistory.length>0&&!sleepHistory[sleepHistory.length-1].wakeupTime){
    sleepHistory[sleepHistory.length-1].wakeupTime=new Date();
    saveSleepData();renderSleepHistory();
  }
}
function checkUserInactivity(){
  if(!sleepSchedule.autoDetectionEnabled||sleepSchedule.sleepModeActive)return;
  if(!sleepSchedule.lastInteractionTime)return;
  var now=new Date();
  var inactiveHours=(now-sleepSchedule.lastInteractionTime)/(1000*60*60);
  // آستانه 1 ساعت، بدون محدودیت ساعت شبانه‌روز (منطق بازتر)
  if(inactiveHours>=1){
    activateSleepMode();
    var wake=new Date(now.getTime()+sleepSchedule.defaultSleepDuration*60*60*1000);
    setWakeupAlarm(wake);
  }
}
function setWakeupAlarm(w){
  var t=formatHM(w);
  if(alarms.some(function(a){return a.time===t&&a.name==='بیداری خودکار';}))return;
  alarms.push({time:t,name:'بیداری خودکار',triggered:false,lastTriggeredAt:0});
  saveAlarmsToLocalStorage();renderAlarms();
}
function checkManualSleepSchedule(now){
  if(!sleepSchedule.manualBedtime||!sleepSchedule.manualWakeupTime)return;
  var cur=now.getHours()*60+now.getMinutes();
  var bed=hmToMinutes(sleepSchedule.manualBedtime);
  var wake=hmToMinutes(sleepSchedule.manualWakeupTime);
  var inSleep;
  if(bed<wake){ inSleep=(cur>=bed&&cur<wake); }
  else { inSleep=(cur>=bed||cur<wake); } // بازه عبور از نیمه‌شب
  if(inSleep&&!sleepSchedule.sleepModeActive) activateSleepMode();
  else if(!inSleep&&sleepSchedule.sleepModeActive) deactivateSleepMode();
}
function renderSleepHistory(){
  var list=document.getElementById('sleep-history-list');
  list.innerHTML='';
  if(sleepHistory.length===0){list.innerHTML='<p>تاریخچه‌ای وجود ندارد</p>';return;}
  var recent=sleepHistory.slice(-10).reverse();
  recent.forEach(function(item){
    var div=document.createElement('div');
    div.className='item';
    var bt=item.bedtime?item.bedtime.toLocaleTimeString('fa-IR',{hour:'2-digit',minute:'2-digit'}):'--:--';
    var bd=item.bedtime?item.bedtime.toLocaleDateString('fa-IR'):'';
    var wt=item.wakeupTime
      ? '<span class="wakeup-time">'+item.wakeupTime.toLocaleTimeString('fa-IR',{hour:'2-digit',minute:'2-digit'})+'</span>'
      : '<span>در حال خواب</span>';
    div.innerHTML='<div><span class="sleep-time">'+bt+'</span> → '+wt+'<div class="date">'+bd+'</div></div><div>'+(item.autoDetected?'خودکار':'دستی')+'</div>';
    list.appendChild(div);
  });
}

/* ---------- آلارم ---------- */
function checkAlarms(now){
  // چک بازه‌ای: هر آلارمی که زمانش بین lastTickTime و now بوده و در دقیقه جاری trigger نشده
  var currentMinute=now.getHours()*60+now.getMinutes();
  alarms.forEach(function(alarm){
    var alarmMinute=hmToMinutes(alarm.time);
    if(alarmMinute!==currentMinute)return;
    // اگر در همین دقیقه قبلاً trigger شده، رد کن
    if(alarm.lastTriggeredAt){
      var last=new Date(alarm.lastTriggeredAt);
      if(last.getHours()===now.getHours()&&last.getMinutes()===now.getMinutes())return;
    }
    alarm.lastTriggeredAt=now.getTime();
    triggerAlarm(alarm);
  });
}
function triggerAlarm(alarm){
  if(sleepSchedule.sleepModeActive)deactivateSleepMode();
  activeAlarm=alarm;
  var overlay=document.getElementById('alarm-overlay');
  document.getElementById('alarm-overlay-title').textContent='آلارم: '+(alarm.name||'بدون عنوان');
  document.getElementById('alarm-overlay-time').textContent='ساعت '+alarm.time;
  overlay.classList.add('active');
  try{
    alarmSound.currentTime=0;
    alarmSound.play().catch(function(){
      // autoplay بلاک شده — کاربر با دکمه خاموش کردن، صدا رو می‌شنوه اگه بخواد
    });
  }catch(e){}
  if('Notification' in window&&Notification.permission==='granted'){
    try{new Notification('آلارم: '+(alarm.name||'بدون عنوان'),{body:'ساعت '+alarm.time});}catch(e){}
  }
}
function dismissAlarm(){
  document.getElementById('alarm-overlay').classList.remove('active');
  try{alarmSound.pause();alarmSound.currentTime=0;}catch(e){}
  activeAlarm=null;
}
function renderAlarms(){
  var list=document.getElementById('alarms-list');
  list.innerHTML='<h3>آلارم‌های فعال</h3>';
  if(alarms.length===0){list.innerHTML+='<p>هیچ آلارمی تنظیم نشده است</p>';return;}
  alarms.forEach(function(alarm,idx){
    var div=document.createElement('div');
    div.className='item';
    div.innerHTML='<div><strong>'+alarm.time+'</strong>'+(alarm.name?' - '+alarm.name:'')+'</div><button class="delete-btn" data-index="'+idx+'">حذف</button>';
    list.appendChild(div);
  });
  list.querySelectorAll('.delete-btn').forEach(function(btn){
    btn.addEventListener('click',function(){
      var i=parseInt(this.getAttribute('data-index'),10);
      alarms.splice(i,1);
      saveAlarmsToLocalStorage();renderAlarms();
    });
  });
}

/* ---------- ساعت جهانی ---------- */
function getTimeParts(tz,withSec){
  var opts={timeZone:tz,hour:'2-digit',minute:'2-digit',hourCycle:'h23'};
  if(withSec)opts.second='2-digit';
  var parts=new Intl.DateTimeFormat('en-GB',opts).formatToParts(new Date());
  var out={};
  parts.forEach(function(p){out[p.type]=p.value;});
  return out;
}
function updateWorldClock(){
  var t=getTimeParts(selectedCity.id,true);
  document.getElementById('selected-city-time').textContent=t.hour+':'+t.minute+':'+t.second;
  document.getElementById('selected-city-name').textContent=selectedCity.name;
  document.getElementById('selected-city-date').textContent=new Intl.DateTimeFormat('fa-IR',{timeZone:selectedCity.id,weekday:'long',year:'numeric',month:'long',day:'numeric'}).format(new Date());
  updateAllCitiesTime();
}
function updateAllCitiesTime(){
  // فقط متن زمان را آپدیت کن، DOM را بازسازی نکن
  var grid=document.getElementById('cities-grid');
  if(grid.children.length!==worldCities.length){
    grid.innerHTML='';
    worldCities.forEach(function(city){
      var card=document.createElement('div');
      card.className='city-card';
      card.setAttribute('data-city-id',city.id);
      card.innerHTML='<div class="city-name">'+city.name+'</div><div class="city-time-small"></div>';
      card.addEventListener('click',function(){selectCity(city);});
      grid.appendChild(card);
    });
  }
  worldCities.forEach(function(city){
    var card=grid.querySelector('[data-city-id="'+city.id+'"]');
    if(!card)return;
    card.classList.toggle('active',city.id===selectedCity.id);
    var t=getTimeParts(city.id,false);
    var timeEl=card.querySelector('.city-time-small');
    if(timeEl)timeEl.textContent=t.hour+':'+t.minute;
  });
}
function selectCity(city){
  selectedCity=city;
  document.getElementById('city-selector').value=city.id;
  updateWorldClock();
  renderGlobeMarkers();
}
function renderGlobeMarkers(){
  var globe=document.getElementById('globe');
  globe.innerHTML='';
  worldCities.forEach(function(city){
    var marker=document.createElement('div');
    marker.className='city-marker';
    marker.setAttribute('data-city',city.name);
    marker.style.backgroundColor=city.color;
    var x=50+45*Math.cos((city.lng-90)*Math.PI/180)*Math.cos(city.lat*Math.PI/180);
    var y=50+45*Math.sin((city.lng-90)*Math.PI/180)*Math.cos(city.lat*Math.PI/180);
    marker.style.left=x+'%';
    marker.style.top=y+'%';
    if(city.id===selectedCity.id){
      marker.style.width='12px';marker.style.height='12px';
      marker.style.boxShadow='0 0 10px '+city.color;
    }
    marker.addEventListener('click',function(){selectCity(city);});
    globe.appendChild(marker);
  });
}
function buildCitySelector(){
  var sel=document.getElementById('city-selector');
  sel.innerHTML='';
  worldCities.forEach(function(city){
    var opt=document.createElement('option');
    opt.value=city.id;opt.textContent=city.name;
    sel.appendChild(opt);
  });
  sel.value=selectedCity.id;
  sel.addEventListener('change',function(e){
    var city=worldCities.find(function(c){return c.id===e.target.value;});
    if(city)selectCity(city);
  });
}

/* ---------- تایمر ---------- */
var timerDisplay=document.getElementById('timer-display');
var startTimerBtn=document.getElementById('start-timer');
var stopTimerBtn=document.getElementById('stop-timer');
var resetTimerBtn=document.getElementById('reset-timer');

function formatDuration(s){
  s=Math.max(0,Math.floor(s));
  return pad2(Math.floor(s/3600))+':'+pad2(Math.floor((s%3600)/60))+':'+pad2(s%60);
}
function tickTimer(){
  var remaining=Math.max(0,Math.round((timerState.endTime-Date.now())/1000));
  timerState.remaining=remaining;
  timerDisplay.textContent=formatDuration(remaining);
  if(remaining<=0){
    stopTimerInternal();
    try{timerSound.currentTime=0;timerSound.play().catch(function(){});}catch(e){}
    // نمایش هشدار به جای alert بلاک‌کننده
    showSimpleToast('زمان تایمر به پایان رسید!');
  }
}
function startTimerInternal(){
  if(timerState.running)return;
  var h=parseInt(document.getElementById('timer-hours').value,10)||0;
  var m=parseInt(document.getElementById('timer-minutes').value,10)||0;
  var s=parseInt(document.getElementById('timer-seconds').value,10)||0;
  var total=h*3600+m*60+s;
  if(total<=0){showSimpleToast('لطفاً زمان معتبر وارد کنید');return;}
  timerState.endTime=Date.now()+total*1000;
  timerState.remaining=total;
  timerState.running=true;
  timerDisplay.textContent=formatDuration(total);
  startTimerBtn.disabled=true;stopTimerBtn.disabled=false;
  timerState.intervalId=setInterval(tickTimer,250);
}
function stopTimerInternal(){
  clearInterval(timerState.intervalId);
  timerState.intervalId=null;
  timerState.running=false;
  startTimerBtn.disabled=false;stopTimerBtn.disabled=true;
}
startTimerBtn.addEventListener('click',startTimerInternal);
stopTimerBtn.addEventListener('click',function(){
  stopTimerInternal();
  timerState.remaining=Math.max(0,Math.round((timerState.endTime-Date.now())/1000));
  timerDisplay.textContent=formatDuration(timerState.remaining);
});
resetTimerBtn.addEventListener('click',function(){
  stopTimerInternal();
  timerState.remaining=0;timerState.endTime=0;
  timerDisplay.textContent='00:00:00';
});

/* ---------- استاپ‌واچ ---------- */
var startSwBtn=document.getElementById('start-stopwatch');
var stopSwBtn=document.getElementById('stop-stopwatch');
var lapSwBtn=document.getElementById('lap-stopwatch');
var resetSwBtn=document.getElementById('reset-stopwatch');
var swDisplay=document.getElementById('stopwatch-display');
var lapList=document.getElementById('lap-list');

function formatSw(ms){
  var total=Math.floor(ms/1000);
  var h=pad2(Math.floor(total/3600));
  var m=pad2(Math.floor((total%3600)/60));
  var s=pad2(total%60);
  var cs=pad2(Math.floor((ms%1000)/10));
  return h+':'+m+':'+s+'.'+cs;
}
function tickSw(){
  swState.elapsed=Date.now()-swState.startTime;
  swDisplay.textContent=formatSw(swState.elapsed);
}
startSwBtn.addEventListener('click',function(){
  if(swState.running)return;
  swState.running=true;
  swState.startTime=Date.now()-swState.elapsed;
  startSwBtn.disabled=true;stopSwBtn.disabled=false;lapSwBtn.disabled=false;
  swState.intervalId=setInterval(tickSw,10);
});
stopSwBtn.addEventListener('click',function(){
  clearInterval(swState.intervalId);
  swState.intervalId=null;
  swState.running=false;
  startSwBtn.disabled=false;stopSwBtn.disabled=true;lapSwBtn.disabled=true;
});
lapSwBtn.addEventListener('click',function(){
  var lapDuration=swState.elapsed-swState.lastLapElapsed;
  swState.lastLapElapsed=swState.elapsed;
  swState.laps.push({total:swState.elapsed,duration:lapDuration});
  var div=document.createElement('div');
  div.className='lap-item';
  div.innerHTML='<span>دور '+swState.laps.length+'</span><span>'+formatSw(lapDuration)+'</span>';
  lapList.appendChild(div);
});
resetSwBtn.addEventListener('click',function(){
  clearInterval(swState.intervalId);
  swState.intervalId=null;
  swState.running=false;
  swState.elapsed=0;swState.startTime=0;swState.laps=[];swState.lastLapElapsed=0;
  swDisplay.textContent='00:00:00.00';
  lapList.innerHTML='<h3>دورها</h3>';
  startSwBtn.disabled=false;stopSwBtn.disabled=true;lapSwBtn.disabled=true;
});

/* ---------- Toast ساده ---------- */
function showSimpleToast(msg){
  var el=document.createElement('div');
  el.textContent=msg;
  el.style.cssText='position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#EA4335;color:#fff;padding:12px 20px;border-radius:8px;z-index:2000;font-family:inherit;box-shadow:0 4px 12px rgba(0,0,0,.4);';
  document.body.appendChild(el);
  setTimeout(function(){el.remove();},3000);
}

/* ---------- تب‌ها ---------- */
function initTabs(){
  var tabs=document.querySelectorAll('.tab');
  tabs.forEach(function(tab){
    tab.addEventListener('click',function(){
      document.querySelectorAll('.tab').forEach(function(t){t.classList.remove('active');t.setAttribute('aria-selected','false');});
      document.querySelectorAll('.tab-content').forEach(function(c){c.classList.remove('active');});
      this.classList.add('active');
      this.setAttribute('aria-selected','true');
      var el=document.getElementById(this.getAttribute('data-tab'));
      if(el)el.classList.add('active');
    });
  });
}

