<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clock App</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background-color: #121212;
            color: white;
            max-width: 500px;
            margin: 0 auto;
            padding: 20px;
        }
        
        .tab-bar {
            display: flex;
            justify-content: space-around;
            padding: 15px 0;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background-color: #1e1e1e;
            max-width: 500px;
            margin: 0 auto;
        }
        
        .tab {
            color: #888;
            font-size: 14px;
        }
        
        .tab.active {
            color: #4a90e2;
        }
        
        .page {
            display: none;
            margin-bottom: 60px;
        }
        
        .page.active {
            display: block;
        }
        
        h1 {
            font-size: 24px;
            margin: 20px 0;
        }
        
        h2 {
            font-size: 18px;
            margin: 15px 0;
            color: #aaa;
        }
        
        .timer-display {
            font-size: 48px;
            text-align: center;
            margin: 30px 0;
        }
        
        .timer-controls {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin: 20px 0;
        }
        
        .timer-btn {
            background-color: #333;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 20px;
            font-size: 16px;
        }
        
        .timer-btn.primary {
            background-color: #4a90e2;
        }
        
        .number-pad {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin: 20px 0;
        }
        
        .number-btn {
            background-color: #333;
            color: white;
            border: none;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            font-size: 24px;
            margin: 0 auto;
        }
        
        .number-btn.wide {
            grid-column: span 2;
            width: 135px;
            border-radius: 30px;
        }
        
        .schedule {
            display: flex;
            justify-content: space-between;
            margin: 20px 0;
            padding: 15px;
            background-color: #1e1e1e;
            border-radius: 10px;
        }
        
        .schedule-item {
            text-align: center;
        }
        
        .schedule-time {
            font-size: 32px;
            font-weight: bold;
        }
        
        .schedule-ampm {
            font-size: 16px;
            color: #888;
        }
        
        .alarm-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            background-color: #1e1e1e;
            border-radius: 10px;
            margin: 10px 0;
        }
        
        .alarm-time {
            font-size: 24px;
            font-weight: bold;
        }
        
        .alarm-ampm {
            font-size: 14px;
            color: #888;
        }
        
        .time-picker {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            text-align: center;
            margin: 20px 0;
        }
        
        .time-number {
            font-size: 24px;
            padding: 10px;
        }
        
        .time-number.active {
            color: #4a90e2;
            font-weight: bold;
        }
        
        .modal-buttons {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }
        
        .modal-btn {
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            font-size: 16px;
        }
        
        .modal-btn.cancel {
            background-color: #333;
            color: white;
        }
        
        .modal-btn.ok {
            background-color: #4a90e2;
            color: white;
        }
        
        .world-clock {
            margin: 15px 0;
            padding: 15px;
            background-color: #1e1e1e;
            border-radius: 10px;
        }
        
        .city-name {
            font-weight: bold;
            margin-bottom: 5px;
        }
        
        .time-diff {
            color: #888;
            font-size: 14px;
        }
        
        .city-time {
            font-size: 24px;
        }
    </style>
</head>
<body>
    <!-- Clock Page -->
    <div class="page active" id="clock-page">
        <div class="current-time">
            <div style="font-size: 48px; text-align: center;">11:13</div>
            <div style="text-align: center; color: #888;">Sat, Jul 26</div>
            <div style="text-align: center; margin-top: 10px;">Sun 10:45 AM</div>
        </div>
        
        <h2>Vancouver</h2>
        <div class="world-clock">
            <div class="time-diff">-10h 30m</div>
            <div class="city-time">12:43 PM</div>
        </div>
        
        <h2>New York</h2>
        <div class="world-clock">
            <div class="time-diff">-7h 30m</div>
            <div class="city-time">3:43 PM</div>
        </div>
        
        <h2>London</h2>
        <div class="world-clock">
            <div class="time-diff">-2h 30m</div>
            <div class="city-time">8:43 PM</div>
        </div>
    </div>
    
    <!-- Alarm Page -->
    <div class="page" id="alarm-page">
        <h1>Alarm</h1>
        
        <h2>Wake up</h2>
        <div class="alarm-item">
            <div>
                <span class="alarm-time">10:45</span>
                <span class="alarm-ampm">AM</span>
            </div>
            <div>
                <input type="checkbox">
            </div>
        </div>
        
        <div style="text-align: center; margin: 30px 0;">
            <button class="timer-btn primary" style="width: 60px; height: 60px; border-radius: 50%; font-size: 24px;">+</button>
        </div>
        
        <!-- Time Picker Modal (hidden by default) -->
        <div style="display: none;" id="time-picker">
            <h2>Wake up</h2>
            <div style="text-align: center; margin: 10px 0;">
                <span style="font-size: 18px;">Select time</span>
                <div style="font-size: 24px; margin: 10px 0;">09:00 AM</div>
            </div>
            
            <div class="time-picker">
                <div class="time-number">55</div>
                <div class="time-number">00</div>
                <div class="time-number">05</div>
                <div class="time-number">50</div>
                <div class="time-number">10</div>
                <div class="time-number">45</div>
                <div class="time-number">40</div>
                <div class="time-number">20</div>
                <div class="time-number">35</div>
                <div class="time-number">25</div>
                <div class="time-number">30</div>
            </div>
            
            <div class="modal-buttons">
                <button class="modal-btn cancel">Cancel</button>
                <button class="modal-btn ok">OK</button>
            </div>
        </div>
    </div>
    
    <!-- Timer Page -->
    <div class="page" id="timer-page">
        <h1>Timer</h1>
        
        <div class="timer-display">00h 00m 00s</div>
        
        <div class="number-pad">
            <button class="number-btn">1</button>
            <button class="number-btn">2</button>
            <button class="number-btn">3</button>
            <button class="number-btn">4</button>
            <button class="number-btn">5</button>
            <button class="number-btn">6</button>
            <button class="number-btn">7</button>
            <button class="number-btn">8</button>
            <button class="number-btn">9</button>
            <button class="number-btn">00</button>
            <button class="number-btn">0</button>
            <button class="number-btn" style="background-color: #4a90e2;">☑</button>
        </div>
        
        <!-- Running Timer View (hidden by default) -->
        <div style="display: none;">
            <div class="timer-display">13s</div>
            <div class="timer-display" style="font-size: 24px;">Timer</div>
            
            <div style="text-align: center; font-size: 32px; margin: 20px 0;">12</div>
            
            <div class="timer-controls">
                <button class="timer-btn">Cancel</button>
                <button class="timer-btn primary">+1:00</button>
            </div>
        </div>
    </div>
    
    <!-- Stopwatch Page -->
    <div class="page" id="stopwatch-page">
        <h1>Stopwatch</h1>
        
        <div class="timer-display">00:00</div>
        
        <div class="timer-controls">
            <button class="timer-btn">Reset</button>
            <button class="timer-btn primary">Start</button>
        </div>
    </div>
    
    <!-- Bedtime Page -->
    <div class="page" id="bedtime-page">
        <h1>Bedtime</h1>
        
        <h2>Schedule</h2>
        <div class="schedule">
            <div class="schedule-item">
                <div>BEDTIME</div>
                <div class="schedule-time">12:16</div>
                <div class="schedule-ampm">AM</div>
            </div>
            <div class="schedule-item">
                <div>WAKE-UP</div>
                <div class="schedule-time">10:45</div>
                <div class="schedule-ampm">AM</div>
            </div>
        </div>
        
        <div style="text-align: center; color: #888; margin: 10px 0;">
            10 hr 29 min • Next alarm on Sunday
        </div>
        
        <hr style="border-color: #333; margin: 20px 0;">
        
        <h2>Recent bedtime activity</h2>
        <div style="color: #888; margin: 10px 0;">
            Your bedtime activity data will appear here tomorrow
        </div>
        
        <div style="display: flex; justify-content: space-between; margin: 20px 0;">
            <span>S</span>
            <span>S</span>
            <span>M</span>
            <span>T</span>
            <span>W</span>
            <span>T</span>
            <span>F</span>
        </div>
        
        <div style="color: #888; margin: 10px 0;">
            ● Time on device ● Time in bed
        </div>
        
        <hr style="border-color: #333; margin: 20px 0;">
        
        <h2>Listen to sleep sounds</h2>
    </div>
    
    <!-- Tab Bar -->
    <div class="tab-bar">
        <div class="tab active" data-page="alarm-page">Alarm</div>
        <div class="tab" data-page="clock-page">Clock</div>
        <div class="tab" data-page="timer-page">Timer</div>
        <div class="tab" data-page="stopwatch-page">Stopwatch</div>
        <div class="tab" data-page="bedtime-page">Bedtime</div>
    </div>
    
    <script>
        // Tab switching functionality
        document.querySelectorAll('.tab').forEach(tab => {
            tab.addEventListener('click', () => {
                // Remove active class from all tabs and pages
                document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
                
                // Add active class to clicked tab and corresponding page
                tab.classList.add('active');
                document.getElementById(tab.dataset.page).classList.add('active');
            });
        });
        
        // Timer functionality would go here
        // Alarm functionality would go here
        // Stopwatch functionality would go here
    </script>
</body>
</html>
