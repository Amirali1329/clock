<!DOCTYPE html>
<html lang="fa">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ساعت، آلارم، تایمر و کرنومتر</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #4285F4;
            --secondary-color: #34A853;
            --danger-color: #EA4335;
            --purple-color: #9C27B0;
            --orange-color: #FF9800;
            --background-dark: #121212;
            --background-light: #1E1E1E;
            --text-primary: #FFFFFF;
            --text-secondary: #9E9E9E;
        }

        * { box-sizing: border-box; }

        body {
            background: var(--background-dark);
            margin: 0;
            padding: 0;
            font-family: 'Roboto', sans-serif;
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: all 0.3s ease;
        }

        .header {
            padding: 16px;
            text-align: center;
            background: var(--background-light);
        }

        .header h1 {
            font-size: 20px;
            font-weight: 500;
            margin: 0;
        }

        .clock-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px 0;
        }

        .time {
            font-size: 120px;
            font-weight: 300;
            letter-spacing: -4px;
            margin-bottom: -10px;
            line-height: 1;
        }

        .seconds {
            font-size: 36px;
            font-weight: 300;
            vertical-align: top;
            opacity: 0.7;
        }

        .date {
            font-size: 18px;
            font-weight: 400;
            opacity: 0.7;
            margin-top: 10px;
        }

        .tabs {
            display: flex;
            justify-content: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
            padding: 0 10px;
        }

        .tab {
            padding: 10px 20px;
            cursor: pointer;
            background: #2D2D2D;
            border: none;
            color: var(--text-primary);
            font-size: 16px;
            flex-grow: 1;
            max-width: 150px;
            font-family: inherit;
            transition: background 0.2s;
        }

        .tab:hover { background: #3D3D3D; }

        .tab.active { background: var(--primary-color); }

        .tab:nth-child(1) { border-radius: 8px 0 0 8px; }
        .tab:nth-child(5) { border-radius: 0 8px 8px 0; }

        .content-container {
            background: var(--background-light);
            padding: 20px;
            border-radius: 16px;
            margin: 0 auto 20px;
            width: 80%;
            max-width: 500px;
        }

        .tab-content { display: none; }
        .tab-content.active { display: block; }

        .form-group {
            display: flex;
            flex-direction: column;
            margin-bottom: 15px;
        }

        label {
            margin-bottom: 8px;
            font-size: 14px;
            color: var(--text-secondary);
        }

        input, select {
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #333;
            background: #2D2D2D;
            color: white;
            font-size: 16px;
            font-family: inherit;
            width: 100%;
        }

        button {
            color: white;
            border: none;
            padding: 12px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 500;
            cursor: pointer;
            margin-top: 10px;
            font-family: inherit;
            transition: opacity 0.2s;
        }

        button:hover:not(:disabled) { opacity: 0.9; }
        button:disabled { opacity: 0.4; cursor: not-allowed; }

        .display {
            font-size: 48px;
            text-align: center;
            margin: 20px 0;
            font-family: monospace;
            direction: ltr;
        }

        .controls {
            display: flex;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .control-btn {
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 16px;
            min-width: 80px;
        }

        .primary-btn { background: var(--primary-color); }
        .secondary-btn { background: var(--secondary-color); }
        .danger-btn { background: var(--danger-color); }
        .purple-btn { background: var(--purple-color); }
        .orange-btn { background: var(--orange-color); }

        .items-list { margin-top: 20px; }

        .item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px;
            background: #2D2D2D;
            border-radius: 8px;
            margin-bottom: 10px;
            gap: 10px;
        }

        .delete-btn {
            background: var(--danger-color);
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 4px;
            cursor: pointer;
            margin: 0;
            font-size: 14px;
        }

        .lap-list {
            margin-top: 20px;
            max-height: 200px;
            overflow-y: auto;
        }

        .lap-item {
            padding: 8px;
            border-bottom: 1px solid #333;
            display: flex;
            justify-content: space-between;
            font-family: monospace;
            direction: ltr;
        }

        /* ساعت جهانی */
        .world-clock-container {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .globe-container {
            position: relative;
            width: 250px;
            height: 250px;
            margin: 20px auto;
        }

        .globe {
            width: 100%;
            height: 100%;
            background: url('https://upload.wikimedia.org/wikipedia/commons/thumb/8/80/Earth_-_Blender_OpenGL.png/1200px-Earth_-_Blender_OpenGL.png') no-repeat center center;
            background-size: cover;
            border-radius: 50%;
            box-shadow: 0 0 20px rgba(66, 133, 244, 0.5);
            position: relative;
            animation: rotate 60s linear infinite;
        }

        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .city-marker {
            position: absolute;
            width: 8px;
            height: 8px;
            background: var(--danger-color);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            cursor: pointer;
            z-index: 2;
        }

        .city-marker::after {
            content: attr(data-city);
            position: absolute;
            white-space: nowrap;
            font-size: 12px;
            color: white;
            background: rgba(0, 0, 0, 0.85);
            padding: 2px 6px;
            border-radius: 4px;
            top: -25px;
            left: 50%;
            transform: translateX(-50%);
            opacity: 0;
            transition: opacity 0.3s;
            pointer-events: none;
        }

        .city-marker:hover::after { opacity: 1; }

        .selected-city {
            font-size: 24px;
            margin: 10px 0;
            color: var(--primary-color);
        }

        .city-time {
            font-size: 36px;
            margin: 10px 0;
            font-family: monospace;
            direction: ltr;
        }

        .city-date {
            font-size: 16px;
            opacity: 0.8;
        }

        .city-selector {
            width: 100%;
            margin: 15px 0;
        }

        .cities-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 10px;
            margin-top: 20px;
            width: 100%;
        }

        .city-card {
            background: #2D2D2D;
            padding: 10px;
            border-radius: 8px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
        }

        .city-card:hover { background: #3D3D3D; }
        .city-card.active { background: var(--primary-color); }

        .city-name {
            font-weight: 500;
            margin-bottom: 5px;
            font-size: 14px;
        }

        .city-time-small {
            font-size: 14px;
            font-family: monospace;
            direction: ltr;
        }

        /* تایم خواب */
        .sleep-mode-form, .auto-sleep-mode {
            background: #2D2D2D;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .sleep-mode-form h3, .auto-sleep-mode h3 {
            margin-top: 0;
            font-size: 16px;
        }

        .sleep-history { margin-top: 20px; }

        .sleep-history .item {
            display: flex;
            justify-content: space-between;
            padding: 10px;
            background: #2D2D2D;
            border-radius: 8px;
            margin-bottom: 8px;
        }

        .sleep-history .sleep-time { color: var(--purple-color); }
        .sleep-history .wakeup-time { color: var(--secondary-color); }

        .sleep-history .date {
            font-size: 12px;
            opacity: 0.7;
        }

        small {
            font-size: 12px;
            color: var(--text-secondary);
            margin-top: 4px;
        }

        /* حالت خواب */
        body.sleep-mode {
            filter: grayscale(100%) brightness(0.7);
        }

        body.sleep-mode .header,
        body.sleep-mode .content-container {
            background: #000 !important;
        }

        @media (max-width: 600px) {
            .time { font-size: 80px; }
            .seconds { font-size: 24px; }
            .content-container { width: 90%; padding: 15px; }
            .display { font-size: 32px; }
            .tab { padding: 8px 10px; font-size: 13px; max-width: none; }
            .globe-container { width: 200px; height: 200px; }
            .cities-grid { grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); }
            .tab:nth-child(1) { border-radius: 8px 0 0 0; }
            .tab:nth-child(5) { border-radius: 0 0 8px 0; }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>ساعت، آلارم، تایمر و کرنومتر</h1>
    </div>

    <div class="clock-container">
        <div class="time" id="hours-minutes">--:--</div>
        <span class="seconds" id="seconds">--</span>
        <div class="date" id="date">--- -- ----</div>
    </div>

    <div class="tabs">
        <button class="tab active" data-tab="alarm-tab">آلارم</button>
        <button class="tab" data-tab="timer-tab">تایمر</button>
        <button class="tab" data-tab="stopwatch-tab">کرنومتر</button>
        <button class="tab" data-tab="world-clock-tab">ساعت جهانی</button>
        <button class="tab" data-tab="sleep-time-tab">تایم خواب</button>
    </div>

    <div class="content-container">
        <!-- آلارم -->
        <div id="alarm-tab" class="tab-content active">
            <h2>تنظیم آلارم</h2>
            <div class="alarm-form">
                <div class="form-group">
                    <label for="alarm-time">زمان آلارم:</label>
                    <input type="time" id="alarm-time" required>
                </div>
                <div class="form-group">
                    <label for="alarm-name">عنوان آلارم (اختیاری):</label>
                    <input type="text" id="alarm-name" placeholder="مثلاً بیدار شدن">
                </div>
                <button class="primary-btn" id="set-alarm">تنظیم آلارم</button>
            </div>
            <div class="items-list" id="alarms-list">
                <h3>آلارم‌های فعال</h3>
            </div>
        </div>

        <!-- تایمر -->
        <div id="timer-tab" class="tab-content">
            <h2>تایمر</h2>
            <div class="timer-form">
                <div class="form-group">
                    <label for="timer-hours">ساعت:</label>
                    <input type="number" id="timer-hours" min="0" max="23" value="0">
                </div>
                <div class="form-group">
                    <label for="timer-minutes">دقیقه:</label>
                    <input type="number" id="timer-minutes" min="0" max="59" value="0">
                </div>
                <div class="form-group">
                    <label for="timer-seconds">ثانیه:</label>
                    <input type="number" id="timer-seconds" min="0" max="59" value="0">
                </div>
                <div class="display" id="timer-display">00:00:00</div>
                <div class="controls">
                    <button class="control-btn secondary-btn" id="start-timer">شروع</button>
                    <button class="control-btn danger-btn" id="stop-timer" disabled>توقف</button>
                    <button class="control-btn purple-btn" id="reset-timer">تنظیم مجدد</button>
                </div>
            </div>
        </div>

        <!-- کرنومتر -->
        <div id="stopwatch-tab" class="tab-content">
            <h2>کرنومتر</h2>
            <div class="stopwatch-form">
                <div class="display" id="stopwatch-display">00:00:00.00</div>
                <div class="controls">
                    <button class="control-btn secondary-btn" id="start-stopwatch">شروع</button>
                    <button class="control-btn danger-btn" id="stop-stopwatch" disabled>توقف</button>
                    <button class="control-btn primary-btn" id="lap-stopwatch" disabled>دور</button>
                    <button class="control-btn purple-btn" id="reset-stopwatch">تنظیم مجدد</button>
                </div>
                <div class="lap-list" id="lap-list">
                    <h3>دورها</h3>
                </div>
            </div>
        </div>

        <!-- ساعت جهانی -->
        <div id="world-clock-tab" class="tab-content">
            <h2>ساعت جهانی</h2>
            <div class="world-clock-container">
                <div class="globe-container">
                    <div class="globe" id="globe"></div>
                </div>
                <div class="selected-city" id="selected-city-name">تهران</div>
                <div class="city-time" id="selected-city-time">--:--:--</div>
                <div class="city-date" id="selected-city-date">--- -- ----</div>
                <select class="city-selector" id="city-selector">
                    <option value="Asia/Tehran">تهران</option>
                    <option value="America/New_York">نیویورک</option>
                    <option value="Europe/London">لندن</option>
                    <option value="Asia/Tokyo">توکیو</option>
                    <option value="Australia/Sydney">سیدنی</option>
                    <option value="Europe/Paris">پاریس</option>
                    <option value="Asia/Dubai">دبی</option>
                    <option value="Asia/Shanghai">شانگهای</option>
                </select>
                <div class="cities-grid" id="cities-grid"></div>
            </div>
        </div>

        <!-- تایم خواب -->
        <div id="sleep-time-tab" class="tab-content">
            <h2>تنظیم تایم خواب</h2>
            <div class="sleep-mode-form">
                <h3>تنظیمات دستی</h3>
                <div class="form-group">
                    <label for="bedtime">ساعت خواب:</label>
                    <input type="time" id="bedtime">
                </div>
                <div class="form-group">
                    <label for="wakeup-time">ساعت بیداری:</label>
                    <input type="time" id="wakeup-time">
                </div>
                <button class="primary-btn" id="set-sleep-schedule">تنظیم برنامه خواب</button>
            </div>

            <div class="auto-sleep-mode">
                <h3>تنظیمات خودکار</h3>
                <div class="form-group">
                    <label>
                        <input type="checkbox" id="auto-sleep-detection" style="width:auto; margin-left:8px;">
                        تشخیص خودکار ساعت خواب
                    </label>
                    <small>اگر از ساعت 11 شب تا 5 صبح به مدت 1 ساعت از گوشی استفاده نکنید، حالت خواب فعال می‌شود</small>
                </div>
                <div class="form-group">
                    <label for="default-sleep-duration">مدت زمان خواب پیش‌فرض:</label>
                    <input type="number" id="default-sleep-duration" min="1" max="12" value="8.5" step="0.5">
                    <small>ساعت (به طور پیش‌فرض 8.5 ساعت)</small>
                </div>
            </div>

            <div class="sleep-history">
                <h3>تاریخچه خواب</h3>
                <div class="items-list" id="sleep-history-list"></div>
            </div>
        </div>
    </div>

    <audio id="alarm-sound" src="https://assets.mixkit.co/sfx/preview/mixkit-alarm-digital-clock-beep-989.mp3" preload="auto"></audio>
    <audio id="timer-sound" src="https://assets.mixkit.co/sfx/preview/mixkit-sound-alert-digital-clock-1035.mp3" preload="auto"></audio>

    <script>
    (function () {
        'use strict';

        // ===== متغیرهای جهانی =====
        let alarms = [];
        let timerInterval = null;
        let timerSecondsLeft = 0;
        let isTimerRunning = false;

        let stopwatchInterval = null;
        let stopwatchStartTime = 0;
        let stopwatchElapsed = 0;
        let isStopwatchRunning = false;
        let laps = [];

        const alarmSound = document.getElementById('alarm-sound');
        const timerSound = document.getElementById('timer-sound');

        // ===== شهرهای جهان =====
        const worldCities = [
            { id: 'Asia/Tehran',        name: 'تهران',   lat: 35.68, lng: 51.38,  color: '#EA4335' },
            { id: 'America/New_York',   name: 'نیویورک', lat: 40.71, lng: -74.01, color: '#4285F4' },
            { id: 'Europe/London',      name: 'لندن',    lat: 51.51, lng: -0.13,  color: '#34A853' },
            { id: 'Asia/Tokyo',         name: 'توکیو',   lat: 35.68, lng: 139.77, color: '#FBBC05' },
            { id: 'Australia/Sydney',   name: 'سیدنی',   lat: -33.87, lng: 151.21, color: '#9C27B0' },
            { id: 'Europe/Paris',       name: 'پاریس',   lat: 48.86, lng: 2.35,   color: '#FF9800' },
            { id: 'Asia/Dubai',         name: 'دبی',     lat: 25.27, lng: 55.31,  color: '#00BCD4' },
            { id: 'Asia/Shanghai',      name: 'شانگهای', lat: 31.23, lng: 121.47, color: '#8BC34A' }
        ];

        let selectedCity = worldCities[0];

        // ===== تایم خواب =====
        let sleepSchedule = {
            manualBedtime: null,
            manualWakeupTime: null,
            autoDetectionEnabled: false,
            defaultSleepDuration: 8.5,
            lastInteractionTime: null,
            sleepModeActive: false
        };

        let sleepHistory = [];

        // ===== ابزارهای کمکی =====
        function pad2(n) { return String(n).padStart(2, '0'); }

        function formatTimeHM(date) {
            return pad2(date.getHours()) + ':' + pad2(date.getMinutes());
        }

        // ===== حالت خواب =====
        function activateSleepMode() {
            if (sleepSchedule.sleepModeActive) return;
            document.body.classList.add('sleep-mode');
            sleepSchedule.sleepModeActive = true;
            sleepHistory.push({
                bedtime: new Date(),
                wakeupTime: null,
                autoDetected: true
            });
            saveSleepData();
            renderSleepHistory();
        }

        function deactivateSleepMode() {
            if (!sleepSchedule.sleepModeActive) return;
            document.body.classList.remove('sleep-mode');
            sleepSchedule.sleepModeActive = false;
            if (sleepHistory.length > 0 && !sleepHistory[sleepHistory.length - 1].wakeupTime) {
                sleepHistory[sleepHistory.length - 1].wakeupTime = new Date();
                saveSleepData();
                renderSleepHistory();
            }
        }

        function checkUserInactivity() {
            if (!sleepSchedule.autoDetectionEnabled) return;
            if (sleepSchedule.sleepModeActive) return;
            const now = new Date();
            const hours = now.getHours();
            if (hours >= 23 || hours < 5) {
                if (sleepSchedule.lastInteractionTime) {
                    const inactiveHours = (now - sleepSchedule.lastInteractionTime) / (1000 * 60 * 60);
                    if (inactiveHours >= 1) {
                        activateSleepMode();
                        const wakeupTime = new Date();
                        wakeupTime.setHours(wakeupTime.getHours() + sleepSchedule.defaultSleepDuration);
                        setWakeupAlarm(wakeupTime);
                    }
                }
            }
        }

        function setWakeupAlarm(wakeupTime) {
            const timeStr = formatTimeHM(wakeupTime);
            // اگر آلارم مشابه وجود دارد، دوباره اضافه نکن
            if (alarms.some(a => a.time === timeStr && a.name === 'بیداری خودکار')) return;
            alarms.push({ time: timeStr, name: 'بیداری خودکار', triggered: false });
            saveAlarmsToLocalStorage();
            renderAlarms();
        }

        // ===== ذخیره/بارگذاری =====
        function saveSleepData() {
            try {
                localStorage.setItem('sleepSchedule', JSON.stringify(sleepSchedule));
                localStorage.setItem('sleepHistory', JSON.stringify(sleepHistory));
            } catch (e) { console.warn('خطا در ذخیره خواب', e); }
        }

        function loadSleepData() {
            try {
                const s = localStorage.getItem('sleepSchedule');
                const h = localStorage.getItem('sleepHistory');
                if (s) {
                    const parsed = JSON.parse(s);
                    Object.assign(sleepSchedule, parsed);
                    if (sleepSchedule.manualBedtime) sleepSchedule.manualBedtime = new Date(sleepSchedule.manualBedtime);
                    if (sleepSchedule.manualWakeupTime) sleepSchedule.manualWakeupTime = new Date(sleepSchedule.manualWakeupTime);
                    if (sleepSchedule.lastInteractionTime) sleepSchedule.lastInteractionTime = new Date(sleepSchedule.lastInteractionTime);
                }
                if (h) {
                    sleepHistory = JSON.parse(h).map(item => ({
                        bedtime: item.bedtime ? new Date(item.bedtime) : null,
                        wakeupTime: item.wakeupTime ? new Date(item.wakeupTime) : null,
                        autoDetected: !!item.autoDetected
                    }));
                }
            } catch (e) { console.warn('خطا در بارگذاری خواب', e); }
        }

        function saveAlarmsToLocalStorage() {
            try { localStorage.setItem('alarms', JSON.stringify(alarms)); }
            catch (e) { console.warn('خطا در ذخیره آلارم', e); }
        }

        function loadAlarmsFromLocalStorage() {
            try {
                const s = localStorage.getItem('alarms');
                if (s) alarms = JSON.parse(s);
            } catch (e) { console.warn('خطا در بارگذاری آلارم', e); }
        }

        // ===== رندر تاریخچه خواب =====
        function renderSleepHistory() {
            const list = document.getElementById('sleep-history-list');
            list.innerHTML = '';
            if (sleepHistory.length === 0) {
                list.innerHTML = '<p>تاریخچه‌ای وجود ندارد</p>';
                return;
            }
            const recent = sleepHistory.slice(-10).reverse();
            recent.forEach(item => {
                const div = document.createElement('div');
                div.className = 'item';
                const bt = item.bedtime
                    ? item.bedtime.toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit' })
                    : '--:--';
                const bd = item.bedtime ? item.bedtime.toLocaleDateString('fa-IR') : '';
                const wt = item.wakeupTime
                    ? `<span class="wakeup-time">${item.wakeupTime.toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit' })}</span>`
                    : '<span>در حال خواب</span>';
                div.innerHTML = `
                    <div>
                        <span class="sleep-time">${bt}</span> → ${wt}
                        <div class="date">${bd}</div>
                    </div>
                    <div>${item.autoDetected ? 'خودکار' : 'دستی'}</div>
                `;
                list.appendChild(div);
            });
        }

        // ===== ساعت اصلی =====
        function updateClock() {
            const now = new Date();
            document.getElementById('hours-minutes').textContent = formatTimeHM(now);
            document.getElementById('seconds').textContent = pad2(now.getSeconds());
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            document.getElementById('date').textContent = now.toLocaleDateString('fa-IR', options);

            checkAlarms(now);
            updateWorldClock();
            checkUserInactivity();
            checkManualSleepSchedule(now);
        }

        function checkManualSleepSchedule(now) {
            if (!sleepSchedule.manualBedtime || !sleepSchedule.manualWakeupTime) return;
            const current = now.getHours() * 60 + now.getMinutes();
            const bed = sleepSchedule.manualBedtime.getHours() * 60 + sleepSchedule.manualBedtime.getMinutes();
            const wake = sleepSchedule.manualWakeupTime.getHours() * 60 + sleepSchedule.manualWakeupTime.getMinutes();

            let inSleep;
            if (bed < wake) {
                inSleep = current >= bed && current < wake;
            } else {
                inSleep = current >= bed || current < wake;
            }

            if (inSleep && !sleepSchedule.sleepModeActive) activateSleepMode();
            else if (!inSleep && sleepSchedule.sleepModeActive) deactivateSleepMode();
        }

        // ===== آلارم‌ها =====
        function checkAlarms(now) {
            if (now.getSeconds() !== 0) return;
            const currentTime = formatTimeHM(now);
            alarms.forEach(alarm => {
                if (alarm.time === currentTime && !alarm.triggered) {
                    alarm.triggered = true;
                    triggerAlarm(alarm);
                    setTimeout(() => { alarm.triggered = false; }, 60000);
                }
            });
        }

        function triggerAlarm(alarm) {
            if (sleepSchedule.sleepModeActive) deactivateSleepMode();
            try { alarmSound.currentTime = 0; alarmSound.play().catch(() => {}); } catch (e) {}
            const title = alarm.name || 'آلارم';
            if ('Notification' in window && Notification.permission === 'granted') {
                new Notification(`زمان ${title} رسیده است`, { body: `ساعت ${alarm.time}` });
            }
            alert(`آلارم ${title}!\nساعت ${alarm.time}`);
        }

        function renderAlarms() {
            const list = document.getElementById('alarms-list');
            list.innerHTML = '<h3>آلارم‌های فعال</h3>';
            if (alarms.length === 0) {
                list.innerHTML += '<p>هیچ آلارمی تنظیم نشده است</p>';
                return;
            }
            alarms.forEach((alarm, index) => {
                const div = document.createElement('div');
                div.className = 'item';
                div.innerHTML = `
                    <div><strong>${alarm.time}</strong>${alarm.name ? ' - ' + alarm.name : ''}</div>
                    <button class="delete-btn" data-index="${index}">حذف</button>
                `;
                list.appendChild(div);
            });
            list.querySelectorAll('.delete-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const i = parseInt(this.getAttribute('data-index'), 10);
                    alarms.splice(i, 1);
                    saveAlarmsToLocalStorage();
                    renderAlarms();
                });
            });
        }

        // ===== ساعت جهانی =====
        function getTimeParts(timeZone, withSeconds) {
            const opts = {
                timeZone,
                hour: '2-digit',
                minute: '2-digit',
                hour12: false
            };
            if (withSeconds) opts.second = '2-digit';
            const fmt = new Intl.DateTimeFormat('en-GB', opts);
            const parts = fmt.formatToParts(new Date());
            const out = {};
            parts.forEach(p => { out[p.type] = p.value; });
            return out;
        }

        function updateWorldClock() {
            const t = getTimeParts(selectedCity.id, true);
            const timeStr = `${t.hour}:${t.minute}:${t.second}`;
            document.getElementById('selected-city-time').textContent = timeStr;
            document.getElementById('selected-city-name').textContent = selectedCity.name;

            const dateOpts = { timeZone: selectedCity.id, weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            document.getElementById('selected-city-date').textContent =
                new Intl.DateTimeFormat('fa-IR', dateOpts).format(new Date());

            updateAllCitiesTime();
        }

        function updateAllCitiesTime() {
            const grid = document.getElementById('cities-grid');
            grid.innerHTML = '';
            worldCities.forEach(city => {
                const t = getTimeParts(city.id, false);
                const card = document.createElement('div');
                card.className = 'city-card' + (city.id === selectedCity.id ? ' active' : '');
                card.innerHTML = `
                    <div class="city-name">${city.name}</div>
                    <div class="city-time-small">${t.hour}:${t.minute}</div>
                `;
                card.addEventListener('click', () => selectCity(city));
                grid.appendChild(card);
            });
        }

        function selectCity(city) {
            selectedCity = city;
            document.getElementById('city-selector').value = city.id;
            updateWorldClock();
            renderGlobeMarkers();
        }

        function renderGlobeMarkers() {
            const globe = document.getElementById('globe');
            globe.innerHTML = '';
            worldCities.forEach(city => {
                const marker = document.createElement('div');
                marker.className = 'city-marker';
                marker.dataset.city = city.name;
                marker.style.backgroundColor = city.color;

                const x = 50 + 45 * Math.cos((city.lng - 90) * Math.PI / 180) * Math.cos(city.lat * Math.PI / 180);
                const y = 50 + 45 * Math.sin((city.lng - 90) * Math.PI / 180) * Math.cos(city.lat * Math.PI / 180);
                marker.style.left = x + '%';
                marker.style.top = y + '%';

                if (city.id === selectedCity.id) {
                    marker.style.width = '12px';
                    marker.style.height = '12px';
                    marker.style.boxShadow = `0 0 10px ${city.color}`;
                }

                marker.addEventListener('click', () => selectCity(city));
                globe.appendChild(marker);
            });
        }

        // ===== تب‌ها =====
        function initTabs() {
            document.querySelectorAll('.tab').forEach(tab => {
                tab.addEventListener('click', () => {
                    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
                    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
                    tab.classList.add('active');
                    const id = tab.getAttribute('data-tab');
                    const el = document.getElementById(id);
                    if (el) el.classList.add('active');
                });
            });
        }

        // ===== آلارم: تنظیم =====
        document.getElementById('set-alarm').addEventListener('click', () => {
            const time = document.getElementById('alarm-time').value;
            const name = document.getElementById('alarm-name').value.trim();
            if (!time) { alert('لطفاً زمان آلارم را وارد کنید'); return; }
            alarms.push({ time, name, triggered: false });
            saveAlarmsToLocalStorage();
            renderAlarms();
            document.getElementById('alarm-time').value = '';
            document.getElementById('alarm-name').value = '';
        });

